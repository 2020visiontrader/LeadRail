# LeadRail environment.
#
# Generated from an audit of every process.env read in lib/, app/ and src/.
# The previous version of this file listed 8 variables and omitted the AI keys
# entirely — including ZO_Api_Key, the PRIMARY model tier — so an environment
# configured from it produced a running app whose assistant reported
# "LeadRail AI is temporarily unavailable". Keep this file in sync when adding
# a new process.env read.
#
# [REQUIRED] = the app is broken without it.

# ---------------------------------------------------------------------------
# Core — Supabase + session
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # [REQUIRED]
# Server-side writes use the service role key (bypasses RLS). Never ships to the
# browser. Without it the app falls back to the anon key, which since migration
# 041 has no grants on agent_memory / agent_conversations.
SUPABASE_SERVICE_ROLE_KEY=               # [REQUIRED]

# Signs the session cookie. Login does not work without it.
APP_SESSION_SECRET=                      # [REQUIRED]

# Public base URL, used in emails, OAuth redirects and unsubscribe links.
APP_URL=
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# AI — the routing ladder. AT LEAST ONE of Zo / OpenCode / NVIDIA is REQUIRED,
# or agentConfigured() is false and the assistant refuses every request.
# Order tried: Zo Ask -> OpenCode Go -> NVIDIA NIM.
# ---------------------------------------------------------------------------

# Zo Ask — PRIMARY tier. NOTE THE MIXED CASE. The code accepts ZO_Api_Key,
# ZO_API_KEY or ZO_CLIENT_IDENTITY_TOKEN, and nothing else.
ZO_Api_Key=                              # [REQUIRED unless another tier is set]
ZOASK_MODEL=                             # optional: pin a byok: model id
ZOASK_TIMEOUT_MS=                        # optional, default 40000
AGENT_ZOASK_MODEL=                       # optional: faster model for the route pass

# OpenCode Go — fallback tier (DeepSeek V4 Pro). https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_BASE_URL=
OPENCODE_TIMEOUT_MS=

# NVIDIA NIM — last-resort tier AND the embedding provider. Without this,
# agent_memory rows are written with a NULL embedding and semantic recall
# silently degrades to recent-facts only. Wanted even when Zo is configured.
NVIDIA_API_KEY=
NIM_MODEL=
NIM_TIMEOUT_MS=

# Google Gemini — image generation.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=

# Encrypts per-account provider keys stored in ai_providers (Settings -> Models).
AI_VAULT_KEY=

# ---------------------------------------------------------------------------
# Agent behaviour flags — all optional, all safe to leave unset
# ---------------------------------------------------------------------------
AGENT_COMPOSE=            # 0 disables the compose pass entirely (packet 8.1)
AGENT_COMPOSE_STREAM=     # 0 keeps compose but stops token streaming (8.2)
AGENT_COMPOSE_CEILING=    # max output tokens for compose, default 8000
AGENT_STAGED_CATALOG=     # 1 enables the two-stage tool catalog (10.3), opt-in
AGENT_SOFT_TOKENS=        # compaction suggestion threshold
AGENT_HARD_TOKENS=        # hard compaction threshold

# ---------------------------------------------------------------------------
# API protection
# ---------------------------------------------------------------------------
# Bearer for the cron tick and the legacy MCP path. Since packet 0.3 an
# APP_API_SECRET caller is READ + safe-write only; sensitive tools require a
# per-account key row in mcp_api_keys.
APP_API_SECRET=
MCP_ACCOUNT_ID=           # legacy single-tenant MCP account scope

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
LEADRAIL_RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
RESEND_WEBHOOK_SECRET=
LEADRAIL_NOTIFY_FROM=
LEADRAIL_NOTIFY_REPLY_TO=
REPLY_TO_EMAIL=
INBOUND_EMAIL_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Social
# ---------------------------------------------------------------------------
# Meta (Facebook Pages + linked Instagram Business accounts). One OAuth pass
# stores EVERY Page the user admins and every linked IG account as its own
# connection row — see app/api/social/meta/callback.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# LinkedIn (packet 7.1). OAuth 2.0 app with the w_member_social product enabled.
# Posting is per-member only — company-page posting needs a separate Organization
# ACL grant this app does not request. Tokens are 60-day and NOT refreshable;
# a stale connection needs the user to reconnect via Settings.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok (packet 7.1). Login Kit v2 app, PKCE. Content Posting API is
# audit-gated: until this app passes TikTok's DIRECT_POST audit, connected
# accounts can only push video drafts to the TikTok inbox for the creator to
# review and post themselves (see lib/social/tiktok-oauth.ts). video_url must
# be on a domain this app has verified with TikTok.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X / Twitter (packet 7.1). OAuth 2.0 confidential client, PKCE. POST /2/tweets
# requires a paid X API tier — confirm the app's plan before relying on
# publishXPost, a free-tier app will fail at publish time.
X_CLIENT_ID=
X_CLIENT_SECRET=

POSTIZ_API_KEY=
POSTIZ_WEBHOOK_SECRET=

# Buffer / GoHighLevel — per-account credentials (packet 7.2). Each account
# connects its own token via Settings → Integrations; it is encrypted with
# AI_VAULT_KEY and stored on that account's integration_connections row.
#
# The three values below are the DEPLOYMENT OWNER's own credentials and are used
# by NOBODY unless SOCIAL_ENV_FALLBACK_ACCOUNT_ID names an account uuid — then
# they apply to that one account and no other. Leave it unset (the default) on
# any multi-tenant deployment: an unbound fallback would authenticate every
# tenant as the operator, which is the leak packet 7.2 closed.
SOCIAL_ENV_FALLBACK_ACCOUNT_ID=
BUFFER_API_KEY=
GOHIGHLEVEL_ACCESS_TOKEN=
GHL_LOCATION_ID=

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
APOLLO_API_KEY=
NOTION_API_KEY=
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER KEYS
# ─────────────────────────────────────────────────────────────────────────────
# Router ladder: zoask -> opencode -> nim -> huggingface -> openrouter.
# A tier with NO key is skipped silently by the router — it looks identical in
# the logs to a tier that was never wired, which is how the OpenRouter tier sat
# unused after being added. Run POST /api/admin/ai-probe (owner only) to see
# which tiers actually answer.

# OpenRouter — https://openrouter.ai/keys  (sk-or-v1-...)
OPENROUTER_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens  (hf_...)
# Token needs the "Make calls to Inference Providers" permission.
HUGGINGFACE_API_KEY=

# Optional: pin one model instead of the built-in fallback chain (each chain
# is verified live and re-checked periodically — see the comment above each
# MODEL_CHAIN in lib/ai/{nim,huggingface,openrouter}.ts for what's in it and
# why).
# OPENROUTER_MODEL=
# HF_MODEL=
# NIM_MODEL=

# Image generation — lib/ai/image-router.ts tries Gemini -> NIM -> OpenRouter
# in order. Gemini uses GEMINI_API_KEY above; NIM and OpenRouter reuse the
# text-chain keys above. Optional overrides:
# NIM_IMAGE_MODEL=          # default: black-forest-labs/flux.1-dev
# OPENROUTER_IMAGE_MODEL=   # default: google/gemini-2.5-flash-image (paid, ~$0.00003/token)

# Optional: fail-fast tuning (defaults zoask 40s / nim 30s / hf 20s).
# ZOASK_TIMEOUT_MS=15000
# NIM_TIMEOUT_MS=20000
# HF_TIMEOUT_MS=20000
