# LeadRail environment.
#
# Generated from an audit of every process.env read in lib/, app/ and src/.
# The previous version of this file listed 8 variables and omitted the AI keys
# entirely — including ZO_Api_Key, the PRIMARY model tier — so an environment
# configured from it produced a running app whose assistant reported
# "LeadRail AI is temporarily unavailable". Keep this file in sync when adding
# a new process.env read.
#
# [REQUIRED] = the app is broken without it.

# ---------------------------------------------------------------------------
# Core — Supabase + session
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                # [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # [REQUIRED]
# Server-side writes use the service role key (bypasses RLS). Never ships to the
# browser. Without it the app falls back to the anon key, which since migration
# 041 has no grants on agent_memory / agent_conversations.
SUPABASE_SERVICE_ROLE_KEY=               # [REQUIRED]

# Signs the session cookie. Login does not work without it.
APP_SESSION_SECRET=                      # [REQUIRED]

# Public base URL, used in emails, OAuth redirects and unsubscribe links.
APP_URL=
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# AI — the routing ladder. AT LEAST ONE of Zo / OpenCode / NVIDIA is REQUIRED,
# or agentConfigured() is false and the assistant refuses every request.
# Order tried: Zo Ask -> OpenCode Go -> NVIDIA NIM.
# ---------------------------------------------------------------------------

# Zo Ask — PRIMARY tier. NOTE THE MIXED CASE. The code accepts ZO_Api_Key,
# ZO_API_KEY or ZO_CLIENT_IDENTITY_TOKEN, and nothing else.
ZO_Api_Key=                              # [REQUIRED unless another tier is set]
ZOASK_MODEL=                             # optional: pin a byok: model id
ZOASK_TIMEOUT_MS=                        # optional, default 40000
AGENT_ZOASK_MODEL=                       # optional: faster model for the route pass

# OpenCode Go — fallback tier (DeepSeek V4 Pro). https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_BASE_URL=
OPENCODE_TIMEOUT_MS=

# NVIDIA NIM — last-resort tier AND the embedding provider. Without this,
# agent_memory rows are written with a NULL embedding and semantic recall
# silently degrades to recent-facts only. Wanted even when Zo is configured.
NVIDIA_API_KEY=
NIM_MODEL=
NIM_TIMEOUT_MS=

# Google Gemini — image generation.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_TEXT_MODEL=

# Encrypts per-account provider keys stored in ai_providers (Settings -> Models).
AI_VAULT_KEY=

# ---------------------------------------------------------------------------
# Agent behaviour flags — all optional, all safe to leave unset
# ---------------------------------------------------------------------------
AGENT_COMPOSE=            # 0 disables the compose pass entirely (packet 8.1)
AGENT_COMPOSE_STREAM=     # 0 keeps compose but stops token streaming (8.2)
AGENT_COMPOSE_CEILING=    # max output tokens for compose, default 8000
AGENT_STAGED_CATALOG=     # 1 enables the two-stage tool catalog (10.3), opt-in
AGENT_SOFT_TOKENS=        # compaction suggestion threshold
AGENT_HARD_TOKENS=        # hard compaction threshold

# ---------------------------------------------------------------------------
# API protection
# ---------------------------------------------------------------------------
# Bearer for the cron tick and the legacy MCP path. Since packet 0.3 an
# APP_API_SECRET caller is READ + safe-write only; sensitive tools require a
# per-account key row in mcp_api_keys.
APP_API_SECRET=
MCP_ACCOUNT_ID=           # legacy single-tenant MCP account scope

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
LEADRAIL_RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
RESEND_WEBHOOK_SECRET=
LEADRAIL_NOTIFY_FROM=
LEADRAIL_NOTIFY_REPLY_TO=
REPLY_TO_EMAIL=
INBOUND_EMAIL_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Social
# ---------------------------------------------------------------------------
# Meta (Facebook Pages + linked Instagram Business accounts). One OAuth pass
# stores EVERY Page the user admins and every linked IG account as its own
# connection row — see app/api/social/meta/callback.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

POSTIZ_API_KEY=
POSTIZ_WEBHOOK_SECRET=

# Buffer / GoHighLevel are GLOBAL (single-tenant) credentials today — the same
# values serve every account, so their capabilities refuse unless the account
# has its own connection row. Per-account storage is packet 7.2.
BUFFER_API_KEY=
GOHIGHLEVEL_ACCESS_TOKEN=
GHL_LOCATION_ID=

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
APOLLO_API_KEY=
NOTION_API_KEY=
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
