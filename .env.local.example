# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side writes use the service role key (bypasses RLS). REQUIRED in production.
SUPABASE_SERVICE_ROLE_KEY=

# --- API protection ---
# When set, all mutating API routes require: Authorization: Bearer <APP_API_SECRET>
APP_API_SECRET=

# --- Brevo (email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_WEBHOOK_SECRET=

# --- Postiz (social) ---
POSTIZ_API_KEY=
POSTIZ_WEBHOOK_SECRET=

# --- Meta (Instagram) ---
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# OpenCode Go — AI text + chat (DeepSeek V4 Pro). Get key at https://opencode.ai/auth
OPENCODE_API_KEY=
